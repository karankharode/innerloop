# --- Supabase ---
# Project Settings -> API Keys (publishable + secret, not legacy JWT anon/service_role)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only. Never expose to the browser. Used by route handlers to write
# anonymous sessions and to read public share pages. Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...

# --- App ---
# Used for absolute URLs (share links, OG image tags, auth redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32+ random bytes. Signs the anonymous-session cookie.
# Generate: openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-long-random-string
